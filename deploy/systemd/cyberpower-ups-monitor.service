[Unit]
Description=CyberPower UPS Monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ups-monitor
Group=ups-monitor
WorkingDirectory=/opt/cyberpower-ups-monitor
Environment=PYTHONPATH=/opt/cyberpower-ups-monitor/src
EnvironmentFile=/etc/cyberpower-ups-monitor/monitor.env
ExecStart=/usr/bin/python3 -m ups_monitor
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/cyberpower-ups-monitor
UMask=0077

[Install]
WantedBy=multi-user.target
