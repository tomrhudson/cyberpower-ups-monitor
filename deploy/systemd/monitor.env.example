UPS_MONITOR_BIND=0.0.0.0
UPS_MONITOR_PORT=8787
UPS_MONITOR_DATABASE=/var/lib/cyberpower-ups-monitor/ups-monitor.sqlite3
UPS_MONITOR_DEVICE_CONFIG=/etc/cyberpower-ups-monitor/devices.json
UPS_MONITOR_INGEST_TOKEN_FILE=/etc/cyberpower-ups-monitor/ingest-token
UPS_MONITOR_STALE_AFTER_SECONDS=180
UPS_MONITOR_RETENTION_DAYS=90
